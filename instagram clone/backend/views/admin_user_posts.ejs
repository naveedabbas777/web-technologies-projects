<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Manage Posts by <%= username %> - Instagram Clone</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  </head>
  <body>
    <div class="navbar">
      <div class="navbar-inner container">
        <div class="brand"><span class="dot"></span> Instagram Clone</div>
        <div class="nav-links">
          <% if (!user) { %>
            <a class="btn primary" href="/auth/login">Login</a>
            <a class="btn ghost" href="/auth/signup">Signup</a>
          <% } %>
        </div>
      </div>
    </div>
    <div class="app-container">
      <aside class="main-sidebar">
        <nav>
          <a class="btn ghost" href="/">Home</a>
          <a class="btn ghost" href="/videos">Video Feed</a>
          <% if (user) { %>
            <a class="btn ghost" href="/users/myposts">My Posts</a>
            <a class="btn primary" href="/posts/new">New Post</a>
            <a class="btn primary" href="/videos/new">New Video Post</a>
            <a class="btn ghost" href="/users/profile">My Profile</a>
            <% if (role === 'admin') { %>
              <a class="btn ghost sidebar-link active" href="/users">Manage Users</a>
              <a class="btn ghost sidebar-link" href="/users/posts-management">Manage All Posts</a>
              <a class="btn ghost sidebar-link" href="/users/comments-management">Manage All Comments</a>
            <% } %>
          <% } %>
        </nav>
        <% if (user) { %>
          <div class="logout-button-container">
            <button class="btn danger" onclick="confirmLogout()">Logout</button>
          </div>
        <% } %>
      </aside>
      <main class="main-content">
        <h1 class="section-title">Posts by <%= username %></h1>
        <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
          <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>
        <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
          <div class="alert alert-success"><%= success_msg %></div>
        <% } %>

        <% if (posts && posts.length) { %>
          <div class="posts-management-grid">
            <% posts.forEach(function(post) { %>
              <div class="admin-post-card">
                <div class="post-header-admin">
                  <a href="/users/<%= post.author._id %>/profile" class="post-author-link">
                    <img src="<%= post.author.profilePicture || '/images/default-profile.png' %>" alt="<%= post.author.username %>" class="post-author-picture" />
                    <span class="post-author-username">@<%= post.author ? post.author.username : 'Unknown' %></span>
                  </a>
                  <span class="post-title-admin">
                    on
                    <% if (post.title) { %>
                      <a href="/posts/<%= post._id %>">"<%= post.title %>"</a>
                    <% } else { %>
                      No Title
                    <% } %>
                  </span>
                </div>
                <% if (post.image) { %>
                  <div class="post-media-admin-container">
                    <img src="<%= post.image %>" alt="<%= post.title %>" class="post-media-admin-image" />
                  </div>
                <% } else if (post.videoPath) { %>
                  <div class="post-media-admin-container">
                    <video controls src="<%= post.videoPath %>" class="post-media-admin-video"></video>
                  </div>
                <% } %>
                <div class="post-body-admin">
                  <p class="post-caption-admin"><%= (post.caption || '').split('\n').slice(0, 3).join('\n') %><%= (post.caption || '').split('\n').length > 3 ? '...' : '' %></p>
                </div>
                <div class="post-footer-admin">
                  <span class="post-timestamp"><%= new Date(post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                  <div class="post-actions-admin">
                    <a href="/posts/<%= post._id %>/edit" class="btn ghost small"><i class="fas fa-edit"></i> Edit</a>
                    <form action="/users/<%= userId %>/posts/<%= post._id %>/delete" method="POST" style="display:inline;">
                      <button type="submit" class="btn danger small"><i class="fas fa-trash-alt"></i> Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="card no-posts-message">No posts found for this user.</div>
        <% } %>
      </main>
    </div>
    <script>
      function confirmLogout() {
        if (confirm("Are you sure you want to log out?")) {
          window.location.href = "/auth/logout";
        }
      }
    </script>
  </body>
</html>
