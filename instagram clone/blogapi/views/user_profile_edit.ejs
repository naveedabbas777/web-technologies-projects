<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Profile - Instagram Clone</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
  <div class="navbar">
    <div class="navbar-inner container">
      <div class="brand"><span class="dot"></span> Instagram Clone</div>
      <div class="nav-links">
        <% if (!user) { %>
          <a class="btn primary" href="/auth/login">Login</a>
          <a class="btn ghost" href="/auth/signup">Signup</a>
        <% } %>
      </div>
    </div>
  </div>
  <div class="app-container">
    <aside class="main-sidebar">
      <nav>
        <a class="btn ghost" href="/">Home</a>
        <a class="btn ghost" href="/videos">Video Feed</a>
        <% if (user) { %>
          <a class="btn ghost" href="/users/myposts">My Posts</a>
          <a class="btn primary" href="/posts/new">New Post</a>
          <a class="btn primary" href="/videos/new">New Video Post</a>
          <a class="btn ghost active" href="/users/profile">My Profile</a>
          <% if (role === 'admin') { %>
            <a class="btn ghost sidebar-link" href="/users">Manage Users</a>
            <a class="btn ghost sidebar-link" href="/users/posts-management">Manage All Posts</a>
            <a class="btn ghost sidebar-link" href="/users/comments-management">Manage All Comments</a>
          <% } %>
        <% } %>
      </nav>
      <% if (user) { %>
        <div class="logout-button-container">
          <button class="btn danger" onclick="confirmLogout()">Logout</button>
        </div>
      <% } %>
    </aside>
    <main class="main-content">
      <div class="profile-edit-card">
        <h1 class="section-title">Edit Profile</h1>
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
          <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>
        <form class="form" action="/users/profile/edit" method="POST" enctype="multipart/form-data">
          <div class="profile-picture-upload-section">
            <img src="<%= profileUser.profilePicture || '/images/default-profile.png' %>" alt="Profile Picture" class="profile-edit-picture" />
            <div class="upload-controls">
              <label for="profilePicture" class="btn ghost"><i class="fas fa-camera"></i> Change Profile Photo</label>
              <input type="file" class="input-hidden" id="profilePicture" name="profilePicture" accept="image/*" />
            </div>
          </div>
          <div class="form-group">
            <label for="username"><i class="fas fa-user icon"></i> Username</label>
            <input class="input" id="username" name="username" value="<%= profileUser.username %>" readonly />
          </div>
          <div class="form-group">
            <label for="email"><i class="fas fa-envelope icon"></i> Email</label>
            <input class="input" id="email" name="email" type="email" value="<%= profileUser.email %>" readonly />
          </div>
          <div class="form-group">
            <label for="bio"><i class="fas fa-address-card icon"></i> Bio</label>
            <textarea class="textarea" id="bio" name="bio" rows="3" placeholder="Tell us about yourself..."><%= typeof formData !== 'undefined' ? formData.bio : profileUser.bio %></textarea>
          </div>
          <div class="form-actions">
            <button class="btn primary" type="submit"><i class="fas fa-save"></i> Save Changes</button>
            <a href="/users/profile" class="btn ghost"><i class="fas fa-ban"></i> Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
  <script>
    function confirmLogout() {
      if (confirm("Are you sure you want to log out?")) {
        window.location.href = "/auth/logout";
      }
    }
  </script>
</body>
</html>
