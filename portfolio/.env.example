# Copy this file to .env.local (do NOT commit your real credentials)
# For Cloudinary unsigned uploads create an upload preset in the Cloudinary dashboard
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
REACT_APP_CLOUDINARY_SIGNING_URL=http://localhost:5000

# EmailJS (optional)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
