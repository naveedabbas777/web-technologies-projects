# Root environment template for the grocery_store repo
#
# Important:
# - Backend runtime reads variables from backend/.env or Render service env vars.
# - Frontend Vite runtime reads variables from frontend-react/.env.
# - Keep secrets out of git. Copy the values below into the correct service.

# =========================
# Backend settings
# =========================
NODE_ENV=development
PORT=5000
DATABASE_TYPE=mongodb

# MongoDB connection
# Use MongoDB Atlas on Render.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Fallback local MongoDB fields
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=grocery_delivery_db
MONGODB_USER=
MONGODB_PASSWORD=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=60000

# URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_URL=http://localhost:5000

# Optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REDIS_ENABLED=false
REDIS_URL=

# Optional payment/email settings
PAYMENT_GATEWAY=stripe
STRIPE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password

# =========================
# Frontend settings
# =========================
# Put this in frontend-react/.env for Vite.
VITE_API_BASE=http://localhost:5000/api