# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Type: 'mysql' or 'mongodb'
DATABASE_TYPE=mongodb

# MySQL Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=grocery_delivery_db
DB_PORT=3306

# MongoDB Configuration
# Option 1: Direct connection
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=grocery_delivery_db
MONGODB_USER=
MONGODB_PASSWORD=

# Option 2: Full MongoDB URI (if using cloud like MongoDB Atlas)
# IMPORTANT: URL-encode special chars in password (e.g. @ becomes %40)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/grocery_delivery_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=60000

# Frontend and CORS URLs
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins. Add your Render frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API base URL (optional)
API_URL=http://localhost:5000

# Database URL (Alternative)
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

